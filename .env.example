# Trained model service. Leave empty until the inference API is ready.
MODEL_API_URL=
MODEL_API_KEY=

# Optional heavy NASA extractor returning numeric science-variable values.
# Example: EARTHDATA_WORKER_URL=http://earthdata-worker:8080
EARTHDATA_WORKER_URL=

# Leave empty when frontend and API share the same FastAPI origin.
# For a separate frontend, use exact origins separated by commas.
CORS_ORIGINS=

FREE_DATA_RADIUS_M=5000
REQUEST_TIMEOUT_SECONDS=30
EARTHDATA_WORKER_TIMEOUT_SECONDS=180
